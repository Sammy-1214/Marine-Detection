)

# Get most recent output folder
result_folder = "runs_testing/detect"
all_result_sub_folders = [os.path.join(result_folder, d) for d in os.listdir(result_folder) if os.path.isdir(os.path.join(result_folder, d))]
latest_folder = max(all_result_sub_folders, key=os.path.getmtime)

# Get all image paths from folder
image_paths = sorted(glob.glob(os.path.join(latest_folder, "*.*"))) # Includes .jpg, .png, etc.

# Read and display image results with OpenCV and arrow navigation
index = 0
while True:
    if not image_paths:
        print("No images found")
        break

    image_results = cv2.imread(image_paths[index])
    if image_results is None:
        print(f"Could not load {image_paths[index]}")
        break

    image_results_resized = imutils.resize(image_results, width=1000)
    cv2.putText(image_results_resized, "Use A/D to scroll, Q or ESC to quit", (10, 30), cv2.FONT_HERSHEY_SIMPLEX, 0.8, (255, 255, 255), 2, cv2.LINE_AA)
    cv2.imshow("Marine Animal YOLO Detection", image_results_resized)
    
    key = cv2.waitKey(0)

    if key == 27 or key == ord("q"): # esc or "q"
        break
    if key == ord("a"): # a key for previous image
        index = (index - 1) % len(image_paths)
    elif key == ord("d"): # d key for next image
        index = (index + 1) % len(image_paths)

cv2.destroyAllWindows

