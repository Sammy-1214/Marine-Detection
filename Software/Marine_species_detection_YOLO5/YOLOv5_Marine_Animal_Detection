# %%
# =================
#  IMAGE DETECTION
# =================

# Run detection and save to folder
detect_run(
    weights=weights_path,
    source="Test_marine_images",
    data="data.yaml",
    project="runs_testing/detect",
    name="predict",
    imgsz=(416, 416),
    conf_thres= 0.35,
    agnostic_nms= True,
    save_conf=True,
    save_txt=True
)

# Get most recent output folder
result_folder = "runs_testing/detect"
all_result_sub_folders = [os.path.join(result_folder, d) for d in os.listdir(result_folder) if os.path.isdir(os.path.join(result_folder, d))]
latest_folder = max(all_result_sub_folders, key=os.path.getmtime)

# Get all image paths from folder
image_paths = sorted(glob.glob(os.path.join(latest_folder, "*.*"))) # Includes .jpg, .png, etc.

# Read and display image results with OpenCV and arrow navigation
index = 0
while True:
    if not image_paths:
        print("No images found")
        break

    image_results = cv2.imread(image_paths[index])
    if image_results is None:
        print(f"Could not load {image_paths[index]}")
        break

    image_results_resized = imutils.resize(image_results, width=1000)
    cv2.putText(image_results_resized, "Use A/D to scroll, Q or ESC to quit", (10, 30), cv2.FONT_HERSHEY_SIMPLEX, 0.8, (255, 255, 255), 2, cv2.LINE_AA)
    cv2.imshow("Marine Animal YOLO Detection", image_results_resized)
    
    key = cv2.waitKey(0)

    if key == 27 or key == ord("q"): # esc or "q"
        break
    if key == ord("a"): # a key for previous image
        index = (index - 1) % len(image_paths)
    elif key == ord("d"): # d key for next image
        index = (index + 1) % len(image_paths)

cv2.destroyAllWindows

#%%
# =================
#  VIDEO DETECTION
# =================

# Video input
video_path = "Test_marine_videos/Penguin.mp4"
video = cv2.VideoCapture(video_path)

n_frames = 50

if not video.isOpened():
    print(f"Error: Could not open video at path: {video_path}")
    exit()

frame_rate = video.get(cv2.CAP_PROP_FPS)
frame_width = int(video.get(cv2.CAP_PROP_FRAME_WIDTH))
frame_height = int(video.get(cv2.CAP_PROP_FRAME_HEIGHT))

# JSON output structure
log = {
    "video_file": os.path.basename(video_path),
    "frame_width": frame_width,
    "frame_height": frame_height,
    "detections": []
}

frame_num = 0
last_detection = []

while video.isOpened():
    success, frame = video.read()
    if not success:
        break
    
    #frame_resized = cv2.resize(frame, (resize_width, resize_height))
    
    # Run YOLOv5 detection
    video_results = model(frame)
    detections = video_results.xyxy[0].cpu().numpy()

    objects = []

    for det in detections:
        x1, y1, x2, y2, conf, cls = det
        label = model.names[int(cls)]
        bbox = [int(x1), int(y1), int(x2), int(y2)]
        centroid = [int((x1 + x2) / 2), int((y1 + y2) / 2)]

        objects.append({
            "label": label,
            "confidence": round(float(conf), 2),
            "bbox": bbox,
            "centroid": centroid
        })

        # Draw box and label
        cv2.rectangle(frame, (bbox[0], bbox[1]), (bbox[2], bbox[3]), (255, 100, 0), 2)
        cv2.putText(frame, f"{label} {conf:.2f}", (bbox[0], bbox[1] - 10), cv2.FONT_HERSHEY_SIMPLEX, 0.6, (255, 100, 0), 2)

    # Check if frame should be logged
    should_log = False

    if frame_num % n_frames == 0:
        should_log = True
    
    # Add detection info to log
    if should_log:
        log["detections"].append({
            "frame_number": frame_num,
            "timestamp": round(frame_num / frame_rate, 3),
            "objects": objects
        })

    # Show frame
    video_results_resized = imutils.resize(frame, width=1200)
    cv2.imshow("Video Detection", video_results_resized)
    
    key = cv2.waitKey(1) & 0xFF
    if key == ord("q") or key == 27:
        break

    frame_num += 1

video.release()
cv2.destroyAllWindows()

# Save JSON log
if frame_num > 0:
    output_name = os.path.join("runs_testing/logs", f"video_log_{datetime.now().strftime("%Y%m%d_%H%M%S")}.json")
    with open(output_name, "w") as f:
        json.dump(log, f, indent=4)
    print(f"Detection log saved as {output_name}")
else:
    print("No frames processed. Log file was not saved")

